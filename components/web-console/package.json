{
  "name": "@openshift-online/hypershell-web-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "architecture:check": "node scripts/check-architecture-config.mjs",
    "build": "react-router build",
    "dev": "react-router dev",
    "format:check": "prettier --check .",
    "i18n:check": "formatjs extract 'app/**/*.{ts,tsx}' '../../packages/gateway-management-ui/src/**/*.{ts,tsx}' --out-file /tmp/hypershell-web-console-en.json && cmp locales/en.json /tmp/hypershell-web-console-en.json",
    "i18n:extract": "formatjs extract 'app/**/*.{ts,tsx}' '../../packages/gateway-management-ui/src/**/*.{ts,tsx}' --out-file locales/en.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "typecheck": "react-router typegen && tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "check": "pnpm run typecheck && pnpm run test:run && pnpm run build"
  },
  "dependencies": {
    "@openshift-online/hypershell-domain-probes": "workspace:0.0.0",
    "@openshift-online/hypershell-gateway-management-ui": "workspace:0.0.0",
    "@opentelemetry/api": "1.9.1",
    "@patternfly/react-core": "6.6.0",
    "@patternfly/react-icons": "6.6.0",
    "@patternfly/react-table": "6.6.0",
    "@react-router/node": "8.3.0",
    "@stego/browser-telemetry": "workspace:1.0.0",
    "@tanstack/react-query": "5.101.4",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "react-intl": "10.1.18",
    "react-router": "8.3.0",
    "web-vitals": "5.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@formatjs/cli": "6.16.14",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@react-router/dev": "8.3.0",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-formatjs": "6.4.19",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
