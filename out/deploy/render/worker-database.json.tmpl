{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "automountServiceAccountToken": false,
      "kind": "ServiceAccount",
      "metadata": {
        "name": "hypershell-database",
        "namespace": "{{.Namespace}}"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "hypershell-database",
        "namespace": "{{.Namespace}}"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 9090,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "{{.Namespace}}"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "hypershell"
                  }
                }
              }
            ]
          },
          {
            "ports": [
              {
                "port": 19093,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "{{.Namespace}}"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "stego-fixture"
                  }
                }
              }
            ]
          },
          {
            "ports": [
              {
                "port": 5353,
                "protocol": "UDP"
              },
              {
                "port": 5353,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "openshift-dns"
                  }
                }
              }
            ]
          }
        ],
        "ingress": [],
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "hypershell-database"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "hypershell-database",
        "namespace": "{{.Namespace}}"
      },
      "spec": {
        "progressDeadlineSeconds": 180,
        "replicas": 1,
        "revisionHistoryLimit": 2,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "hypershell-database"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "hypershell-database"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "GOMEMLIMIT",
                    "value": "384MiB"
                  },
                  {
                    "name": "STEGO_DATABASE_ALLOW_INSECURE_LOOPBACK",
                    "value": "0"
                  },
                  {
                    "name": "STEGO_CONTROLLER_MONITOR_ADDR",
                    "value": "127.0.0.1:9081"
                  },
                  {
                    "name": "OTEL_SERVICE_NAME",
                    "value": "hypershell-database"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "hypershell-database-runtime"
                    }
                  }
                ],
                "image": "{{.Image}}",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "/worker",
                      "--stego-probe=live"
                    ]
                  },
                  "failureThreshold": 3,
                  "periodSeconds": 10,
                  "timeoutSeconds": 2
                },
                "name": "worker",
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "/worker",
                      "--stego-probe=ready"
                    ]
                  },
                  "failureThreshold": 2,
                  "periodSeconds": 3,
                  "timeoutSeconds": 2
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "ephemeral-storage": "128Mi",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "ephemeral-storage": "32Mi",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "/worker",
                      "--stego-probe=live"
                    ]
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 2,
                  "timeoutSeconds": 2
                },
                "volumeMounts": [
                  {
                    "mountPath": "/var/run/stego",
                    "name": "files",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  }
                ]
              }
            ],
            "securityContext": {
              "fsGroup": {{.FSGroup}},
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccountName": "hypershell-database",
            "terminationGracePeriodSeconds": 60,
            "volumes": [
              {
                "name": "files",
                "secret": {
                  "defaultMode": 288,
                  "secretName": "hypershell-database-files"
                }
              },
              {
                "emptyDir": {
                  "sizeLimit": "64Mi"
                },
                "name": "tmp"
              }
            ]
          }
        }
      }
    }
  ],
  "kind": "List"
}