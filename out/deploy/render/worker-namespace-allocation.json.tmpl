    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "name": "{{.Namespace}}.hypershell-namespace-allocation.pods.sandbox"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConditions": [
          {
            "expression": "request.namespace != '{{.Namespace}}'",
            "name": "selected-identity"
          }
        ],
        "matchConstraints": {
          "namespaceSelector": {
            "matchLabels": {
              "stego.dev/allocation-profile": "sandbox",
              "stego.dev/allocator": "{{allocationID .Namespace `hypershell-namespace-allocation`}}"
            }
          },
          "resourceRules": [
            {
              "apiGroups": [
                ""
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "pods",
                "pods/status",
                "pods/ephemeralcontainers"
              ],
              "scope": "Namespaced"
            }
          ]
        },
        "validations": [
          {
            "expression": "namespaceObject != null \u0026\u0026 ((namespaceObject != null \u0026\u0026 has(namespaceObject.metadata.labels) \u0026\u0026 'stego.dev/allocator' in namespaceObject.metadata.labels \u0026\u0026 namespaceObject.metadata.labels['stego.dev/allocator'] == \"{{allocationID .Namespace `hypershell-namespace-allocation`}}\") \u0026\u0026 'stego.dev/allocation-profile' in namespaceObject.metadata.labels \u0026\u0026 namespaceObject.metadata.labels['stego.dev/allocation-profile'] == \"sandbox\" \u0026\u0026 \"hypershell.redhat.io/gateway-id\" in namespaceObject.metadata.labels \u0026\u0026 namespaceObject.metadata.labels[\"hypershell.redhat.io/gateway-id\"].matches('^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$') \u0026\u0026 'app.kubernetes.io/managed-by' in namespaceObject.metadata.labels \u0026\u0026 namespaceObject.metadata.labels['app.kubernetes.io/managed-by'] == \"hypershell-gateway-controller\") \u0026\u0026 (request.namespace != '{{.Namespace}}' \u0026\u0026 request.namespace.matches(\"^openshell-sandbox-[a-z0-9][a-z0-9-]{14}[a-z0-9]$\")) \u0026\u0026 namespaceObject.metadata.labels['pod-security.kubernetes.io/enforce'] == 'privileged'",
            "message": "Pod requires a current allocation with its declared Pod security"
          },
          {
            "expression": "has(object.spec.runtimeClassName) \u0026\u0026 object.spec.runtimeClassName == \"kata\"",
            "message": "Pod must use the declared RuntimeClass"
          },
          {
            "expression": "namespaceObject != null \u0026\u0026 (has(namespaceObject.metadata.annotations) \u0026\u0026 \"stego.dev/service-account-sandbox\" in namespaceObject.metadata.annotations \u0026\u0026 namespaceObject.metadata.annotations[\"stego.dev/service-account-sandbox\"].matches(\"^sa-{{allocationID .Namespace `hypershell-namespace-allocation`}}-[a-z2-7]{26}$\")) \u0026\u0026 object.spec.serviceAccountName == namespaceObject.metadata.annotations[\"stego.dev/service-account-sandbox\"] \u0026\u0026 has(object.spec.automountServiceAccountToken) \u0026\u0026 !object.spec.automountServiceAccountToken",
            "message": "Pod must use its allocated ServiceAccount and disable automatic token mounting"
          },
          {
            "expression": "(!has(object.spec.os) || object.spec.os.name == 'linux') \u0026\u0026 (!has(object.spec.hostNetwork) || !object.spec.hostNetwork) \u0026\u0026 (!has(object.spec.hostPID) || !object.spec.hostPID) \u0026\u0026 (!has(object.spec.hostIPC) || !object.spec.hostIPC)",
            "message": "Isolated Pods require Linux and cannot use host namespaces"
          },
          {
            "expression": "!has(object.spec.ephemeralContainers) || size(object.spec.ephemeralContainers) == 0",
            "message": "Isolated Pods cannot add ephemeral containers"
          },
          {
            "expression": "!has(object.spec.resourceClaims) || size(object.spec.resourceClaims) == 0",
            "message": "Isolated Pods cannot request dynamic devices"
          },
          {
            "expression": "!has(object.spec.securityContext) || ((!has(object.spec.securityContext.sysctls) || size(object.spec.securityContext.sysctls) == 0) \u0026\u0026 !has(object.spec.securityContext.windowsOptions))",
            "message": "Isolated Pods cannot set sysctls or Windows options"
          },
          {
            "expression": "variables.containers.all(c, !has(c.securityContext) || ((!has(c.securityContext.privileged) || !c.securityContext.privileged) \u0026\u0026 (!has(c.securityContext.allowPrivilegeEscalation) || !c.securityContext.allowPrivilegeEscalation) \u0026\u0026 (!has(c.securityContext.procMount) || c.securityContext.procMount == 'Default') \u0026\u0026 !has(c.securityContext.windowsOptions)))",
            "message": "Isolated containers cannot request privileged mode, privilege escalation, or unmasked proc storage"
          },
          {
            "expression": "variables.containers.all(c, !has(c.ports) || c.ports.all(p, !has(p.hostPort) || p.hostPort == 0))",
            "message": "Isolated containers cannot bind host ports"
          },
          {
            "expression": "variables.containers.all(c, (!has(c.volumeDevices) || size(c.volumeDevices) == 0) \u0026\u0026 (!has(c.volumeMounts) || c.volumeMounts.all(m, !has(m.mountPropagation) || m.mountPropagation == 'None')))",
            "message": "Isolated containers cannot mount block devices or propagate mounts"
          },
          {
            "expression": "variables.containers.all(c, !has(c.resources) || ((!has(c.resources.claims) || size(c.resources.claims) == 0) \u0026\u0026 (!has(c.resources.limits) || c.resources.limits.all(k, k in ['cpu','memory','ephemeral-storage'])) \u0026\u0026 (!has(c.resources.requests) || c.resources.requests.all(k, k in ['cpu','memory','ephemeral-storage']))))",
            "message": "Isolated containers cannot request extended resources or devices"
          },
          {
            "expression": "!has(object.spec.volumes) || object.spec.volumes.all(v, has(v.configMap) || has(v.downwardAPI) || has(v.emptyDir) || has(v.persistentVolumeClaim) || has(v.projected) || has(v.secret) || has(v.image))",
            "message": "Isolated Pods require approved volume types"
          },
          {
            "expression": "(((oldObject != null \u0026\u0026 has(oldObject.metadata.annotations) \u0026\u0026 \"k8s.ovn.org/pod-networks\" in oldObject.metadata.annotations) == (has(object.metadata.annotations) \u0026\u0026 \"k8s.ovn.org/pod-networks\" in object.metadata.annotations) \u0026\u0026 (!(oldObject != null \u0026\u0026 has(oldObject.metadata.annotations) \u0026\u0026 \"k8s.ovn.org/pod-networks\" in oldObject.metadata.annotations) || oldObject.metadata.annotations[\"k8s.ovn.org/pod-networks\"] == object.metadata.annotations[\"k8s.ovn.org/pod-networks\"])) || (request.operation == 'UPDATE' \u0026\u0026 request.subResource == 'status' \u0026\u0026 oldObject != null \u0026\u0026 has(oldObject.spec.nodeName) \u0026\u0026 oldObject.spec.nodeName != '' \u0026\u0026 has(object.spec.nodeName) \u0026\u0026 object.spec.nodeName == oldObject.spec.nodeName \u0026\u0026 request.userInfo.username == \"system:ovn-node:\" + oldObject.spec.nodeName \u0026\u0026 \"system:ovn-nodes\" in request.userInfo.groups))",
            "message": "OVN Pod metadata requires the assigned network node identity"
          },
          {
            "expression": "(((oldObject != null \u0026\u0026 has(oldObject.metadata.annotations) \u0026\u0026 \"k8s.v1.cni.cncf.io/network-status\" in oldObject.metadata.annotations) == (has(object.metadata.annotations) \u0026\u0026 \"k8s.v1.cni.cncf.io/network-status\" in object.metadata.annotations) \u0026\u0026 (!(oldObject != null \u0026\u0026 has(oldObject.metadata.annotations) \u0026\u0026 \"k8s.v1.cni.cncf.io/network-status\" in oldObject.metadata.annotations) || oldObject.metadata.annotations[\"k8s.v1.cni.cncf.io/network-status\"] == object.metadata.annotations[\"k8s.v1.cni.cncf.io/network-status\"])) || (request.operation == 'UPDATE' \u0026\u0026 request.subResource == 'status' \u0026\u0026 oldObject != null \u0026\u0026 has(oldObject.spec.nodeName) \u0026\u0026 oldObject.spec.nodeName != '' \u0026\u0026 has(object.spec.nodeName) \u0026\u0026 object.spec.nodeName == oldObject.spec.nodeName \u0026\u0026 request.userInfo.username == \"system:multus:\" + oldObject.spec.nodeName \u0026\u0026 \"system:multus\" in request.userInfo.groups))",
            "message": "Multus Pod metadata requires the assigned network node identity"
          },
          {
            "expression": "!has(object.metadata.annotations) || object.metadata.annotations.all(k, k in [\"openshift.io/scc\",\"security.openshift.io/validated-scc-subject-type\",\"openshell.io/sandbox-id\",\"agents.x-k8s.io/propagated-labels\",\"agents.x-k8s.io/propagated-annotations\",\"k8s.ovn.org/pod-networks\",\"k8s.v1.cni.cncf.io/network-status\"] || (k == 'seccomp.security.alpha.kubernetes.io/pod' \u0026\u0026 object.metadata.annotations[k] == 'runtime/default' \u0026\u0026 has(object.spec.securityContext) \u0026\u0026 has(object.spec.securityContext.seccompProfile) \u0026\u0026 object.spec.securityContext.seccompProfile.type == 'RuntimeDefault'))",
            "message": "Isolated Pods cannot set undeclared annotations"
          },
          {
            "expression": "variables.containers.all(c, !has(c.securityContext) || !has(c.securityContext.capabilities) || !has(c.securityContext.capabilities.add) || size(c.securityContext.capabilities.add) == 0 || (has(c.securityContext.allowPrivilegeEscalation) \u0026\u0026 !c.securityContext.allowPrivilegeEscalation \u0026\u0026 has(c.securityContext.capabilities.drop) \u0026\u0026 'ALL' in c.securityContext.capabilities.drop \u0026\u0026 ((c.name == \"openshell-network-init\" \u0026\u0026 c.image == \"quay.io/opendatahub/odh-openshell-supervisor:v0.0.109-rhaiv.0@sha256:96e21135c18bc9f6f4d1dfd0cccae3c91769ef4d87da2e470eca4b56a24b2152\" \u0026\u0026 c.securityContext.capabilities.add.all(a, a in [\"NET_ADMIN\",\"NET_RAW\",\"CHOWN\",\"FOWNER\"])) || (c.name == \"openshell-supervisor-network\" \u0026\u0026 c.image == \"quay.io/opendatahub/odh-openshell-supervisor:v0.0.109-rhaiv.0@sha256:96e21135c18bc9f6f4d1dfd0cccae3c91769ef4d87da2e470eca4b56a24b2152\" \u0026\u0026 c.securityContext.capabilities.add.all(a, a in [\"SYS_PTRACE\",\"DAC_READ_SEARCH\"])))))",
            "message": "Added capabilities require a declared container name, pinned image, and capability set"
          },
          {
            "expression": "variables.containers.all(c, c.name in ['agent','workspace-init','openshell-network-init','openshell-supervisor-network'])",
            "message": "Sandbox container names must match OpenShell"
          },
          {
            "expression": "variables.containers.all(c, !(c.name in ['openshell-network-init','openshell-supervisor-network']) || c.image == 'quay.io/opendatahub/odh-openshell-supervisor:v0.0.109-rhaiv.0@sha256:96e21135c18bc9f6f4d1dfd0cccae3c91769ef4d87da2e470eca4b56a24b2152')",
            "message": "Sandbox network helpers must use the selected supervisor image"
          },
          {
            "expression": "variables.containers.all(c, c.name != 'agent' || (has(c.securityContext) \u0026\u0026 has(c.securityContext.runAsNonRoot) \u0026\u0026 c.securityContext.runAsNonRoot \u0026\u0026 has(c.securityContext.runAsUser) \u0026\u0026 c.securityContext.runAsUser != 0 \u0026\u0026 has(c.securityContext.allowPrivilegeEscalation) \u0026\u0026 !c.securityContext.allowPrivilegeEscalation \u0026\u0026 has(c.securityContext.capabilities) \u0026\u0026 has(c.securityContext.capabilities.drop) \u0026\u0026 'ALL' in c.securityContext.capabilities.drop))",
            "message": "Sandbox workloads must run as a non-root user without extra capabilities"
          },
          {
            "expression": "variables.containers.all(c, !(c.name in ['agent','workspace-init']) || !has(c.volumeMounts) || c.volumeMounts.all(m, !(m.name in ['openshell-client-tls','openshell-sa-token'])))",
            "message": "Sandbox workloads and workspace helpers cannot mount client credentials"
          },
          {
            "expression": "variables.containers.all(c, (!has(c.env) || c.env.all(e, !has(e.valueFrom) || !has(e.valueFrom.secretKeyRef))) \u0026\u0026 (!has(c.envFrom) || c.envFrom.all(e, !has(e.secretRef))))",
            "message": "Sandbox containers cannot read Secrets through environment variables"
          },
          {
            "expression": "!has(object.spec.volumes) || object.spec.volumes.all(v, has(v.emptyDir) || (has(v.image) \u0026\u0026 v.image.reference == 'quay.io/opendatahub/odh-openshell-supervisor:v0.0.109-rhaiv.0@sha256:96e21135c18bc9f6f4d1dfd0cccae3c91769ef4d87da2e470eca4b56a24b2152') || (has(v.secret) \u0026\u0026 v.name == 'openshell-client-tls' \u0026\u0026 v.secret.secretName == 'openshell-client-tls') || (has(v.projected) \u0026\u0026 v.name == 'openshell-sa-token' \u0026\u0026 v.projected.sources.all(s, has(s.serviceAccountToken) \u0026\u0026 has(s.serviceAccountToken.audience) \u0026\u0026 s.serviceAccountToken.audience == 'openshell-gateway' \u0026\u0026 has(s.serviceAccountToken.expirationSeconds) \u0026\u0026 s.serviceAccountToken.expirationSeconds \u003c= 3600)) || (has(v.persistentVolumeClaim) \u0026\u0026 v.name == 'workspace' \u0026\u0026 has(object.metadata.ownerReferences) \u0026\u0026 object.metadata.ownerReferences.exists(o, o.kind == 'Sandbox' \u0026\u0026 o.apiVersion.startsWith('agents.x-k8s.io/') \u0026\u0026 has(o.controller) \u0026\u0026 o.controller \u0026\u0026 v.persistentVolumeClaim.claimName == 'workspace-' + o.name)))",
            "message": "Sandbox storage must match OpenShell workspace and identity rules"
          }
        ],
        "variables": [
          {
            "expression": "object.spec.containers + (has(object.spec.initContainers) ? object.spec.initContainers : [])",
            "name": "containers"
          }
        ]
      }
    },
